{
  "version": 1,
  "name": "TopicScope",
  "design": {
    "version": 1,
    "pages": [
      {
        "id": "home",
        "path": "/",
        "title": "TopicScope · 选题雷达",
        "width": 1440,
        "height": 900,
        "elements": [
          {
            "selector": "header",
            "title": "站点标题与检索入口"
          },
          {
            "selector": "input[placeholder=\"输入研究方向，例如 medical image segmentation\"]",
            "title": "研究方向输入框"
          },
          {
            "selector": "button:has-text(\"在线检索\")",
            "title": "在线检索按钮"
          },
          {
            "selector": "button:has-text(\"离线示例\")",
            "title": "离线示例按钮"
          },
          {
            "selector": "[role=\"tablist\"]",
            "title": "功能页签（含文献综述）"
          },
          {
            "selector": "[role=\"tabpanel\"]",
            "title": "当前功能面板"
          },
          {
            "selector": "button:has-text(\"生成方向建议\")",
            "title": "生成研究方向建议按钮"
          },
          {
            "selector": "button:has-text(\"导师汇报\")",
            "title": "导师汇报对比页入口"
          },
          {
            "selector": "svg[role=\"img\"]",
            "title": "方向按年发文量趋势图"
          },
          {
            "selector": "button:has-text(\"生成综述草稿\")",
            "title": "生成文献综述草稿按钮"
          },
          {
            "selector": "button:has-text(\"生成研究方案\")",
            "title": "生成研究方案按钮"
          },
          {
            "selector": "button:has-text(\"导出方案 Markdown\")",
            "title": "导出研究方案按钮"
          },
          {
            "selector": "button:has-text(\"保存会话\")",
            "title": "保存研究会话按钮"
          },
          {
            "selector": "[role=\"dialog\"]",
            "title": "论文证据卡与导师汇报面板"
          },
          {
            "selector": "canvas",
            "title": "关键词共现力导向图"
          },
          {
            "selector": "footer",
            "title": "数据来源与免责说明"
          }
        ]
      }
    ],
    "capabilities": [
      "appearance",
      "radius",
      "spacing",
      "typography",
      "motion"
    ]
  },
